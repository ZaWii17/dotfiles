layout {
    gaps 4

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        off
    }

    border {
        width 1 
    }
    background-color "#b7bdf811"
}

    // Đưa lớp nền của swaybg vào backdrop của Overview
    layer-rule {
        match namespace="^wallpaper$"
        place-within-backdrop true
    }

