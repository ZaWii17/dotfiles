configuration {
    modi: "run,drun,window";
    font: "JetBrains Mono 12";
    show-icons: true;
    terminal: "ghostty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: ""; 
}

@theme "/dev/null" /* Xóa theme mặc định để áp dụng style bên dưới */

* {
    bg: #1e1e2e;
    bg-alt: #313244;
    fg: #cdd6f4;
    accent: #89b4fa;
    
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 45%;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 10px;
    padding: 15px;
}

element {
    padding: 8px 12px;
    border-radius: 6px;
    text-color: @fg;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 24px;
    padding: 0 10px 0 0;
}

entry {
    background-color: @bg-alt;
    padding: 10px;
    border-radius: 6px;
    margin: 0 0 10px 0;
}

listview {
    lines: 5;      
    columns: 1;     
}